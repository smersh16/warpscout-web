FROM golang:1.26-alpine AS build
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /warpscout-web ./cmd/warpscout-web

FROM alpine:3.24
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 warpscout && mkdir /data && chown warpscout /data
COPY --from=build /warpscout-web /usr/local/bin/warpscout-web
USER warpscout
ENV WARPSCOUT_LISTEN=0.0.0.0:8787 WARPSCOUT_DATA=/data
VOLUME /data
EXPOSE 8787
ENTRYPOINT ["warpscout-web"]
